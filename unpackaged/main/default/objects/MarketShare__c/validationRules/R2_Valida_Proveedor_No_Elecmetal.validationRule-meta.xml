<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>R2_Valida_Proveedor_No_Elecmetal</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
     NOT(ISPICKVAL(Proveedor__c,&#39;Elecmetal&#39;)),
		  		 ISBLANK(Descripcion_Pieza__c) 
				  
    )</errorConditionFormula>
    <errorDisplayField>Producto__c</errorDisplayField>
    <errorMessage>Cuando el proveedor NO es &quot;Elecmetal&quot; ,Debe ingresar un valor en la descripción de pieza</errorMessage>
</ValidationRule>
