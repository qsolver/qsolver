    <fullName>Consumo_Anual_Elecmetal_Chancado__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(Proveedor_del_Set__c , &#39;Elecmetal&#39;),

IF(ISBLANK(TEXT(N_Molinos__c))
, ((Peso_del_Set__c * (12/DuracionSetMeses__c))) ,

((Peso_del_Set__c * (12/DuracionSetMeses__c) * VALUE(TEXT(N_Molinos__c))) )

)

 ,
0

)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
