<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validar_Secuencia_Fechas_LBase_Instalaci</fullName>
    <active>true</active>
    <description>Fecha_de_L_Base__c	&lt;	Fecha_de_instalacion__c</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Fecha_de_L_Base__c)),
    NOT(ISBLANK(Fecha_de_instalacion__c)),
    Fecha_de_L_Base__c &gt;= Fecha_de_instalacion__c
)</errorConditionFormula>
    <errorDisplayField>Fecha_de_instalacion__c</errorDisplayField>
    <errorMessage>Error en secuencia de fechas: La Fecha de L Base debe ser ANTERIOR a la Fecha de Instalación.</errorMessage>
</ValidationRule>
