<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Make_Sub_Line_of_Business_Required_forSA</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ELM_Sales_Team__c = &#39;SURAMERICA&#39;,  ISPICKVAL( Sub_Line_of_Business__c , &#39;&#39;), ISNEW(),
NOT($User.Profile_Filter__c = &#39;GM&#39;))</errorConditionFormula>
