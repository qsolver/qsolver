<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_approval_by_SV_and_PM</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(ELM_Status__c, &#39;Eliminado&#39;),ISCHANGED(ELM_Status__c),OR( ISPICKVAL(Aprobado_por_Subgerente_de_Ventas__c, &#39;&#39;), ISPICKVAL(Aprobado_por_PM__c, &#39;&#39;), ISPICKVAL(Aprobado_por_Subgerente_de_Ventas__c, &#39;No&#39;),
ISPICKVAL(Aprobado_por_PM__c, &#39;No&#39;)))</errorConditionFormula>
    <errorMessage>Debe llenar los campos &quot;Aprobado por Subgerente de Ventas?&quot; y &quot;Aprobado por PM?&quot; y ambos deben tener el valor &quot;Si&quot;</errorMessage>
</ValidationRule>
