<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Motivo_de_rechazo_obligatorio</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Rejected&quot;),
    ISBLANK(TEXT(Motivo_de_rechazo__c))
)</errorConditionFormula>
    <errorDisplayField>Motivo_de_rechazo__c</errorDisplayField>
    <errorMessage>Para cambiar el estado a Rejected, debe seleccionar un Motivo de Rechazo.</errorMessage>
</ValidationRule>
