<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Duration_greater_than_0</fullName>
    <active>true</active>
    <errorConditionFormula>ELM_Duration__c &lt; 1</errorConditionFormula>
    <errorDisplayField>ELM_Duration__c</errorDisplayField>
