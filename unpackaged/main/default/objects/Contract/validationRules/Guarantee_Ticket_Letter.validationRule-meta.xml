<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Guarantee_Ticket_Letter</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
TEXT(Guarantee_Ticket__c)= &quot;Yes&quot;,
ELM_Letter_Attached__c &lt;&gt; true,
$Permission.Integrator = false
)</errorConditionFormula>
    <errorDisplayField>ELM_Letter_Attached__c</errorDisplayField>
    <errorMessage>Please select fill in Letter</errorMessage>
</ValidationRule>
