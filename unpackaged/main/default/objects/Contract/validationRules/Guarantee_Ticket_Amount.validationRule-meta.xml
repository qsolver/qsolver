<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Guarantee_Ticket_Amount</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
TEXT(Guarantee_Ticket__c)= &quot;Yes&quot;,
ISBLANK(ELM_Ticket_Amount__c),
$Permission.Integrator = false
)</errorConditionFormula>
