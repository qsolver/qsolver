<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Make_Comments_Requiered</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Estado__c, &quot;REJECTED&quot;),
    ISCHANGED(Estado__c),
    ISBLANK(Comentarios_Rechazos__c)
)</errorConditionFormula>
    <errorDisplayField>Comentarios_Rechazos__c</errorDisplayField>
    <errorMessage>Para pasar a REJECTED tiene que llenar el campo comentarios</errorMessage>
</ValidationRule>
