<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Initial_Captura_Services_Stage</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
RecordType.Name = &quot;Component Services&quot;,
ISNEW(),
TEXT( StageName)&lt;&gt; &quot;Capture&quot;
)</errorConditionFormula>
    <errorDisplayField>StageName</errorDisplayField>
    <errorMessage>Initial Stage must be Capture</errorMessage>
</ValidationRule>
