<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AccountName_Qualification_Stage</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
 TEXT(StageName) = &quot;Qualification&quot;,
ISBLANK( AccountId )
)</errorConditionFormula>
    <errorDisplayField>AccountId</errorDisplayField>
    <errorMessage>Please fill in the following field Account Name</errorMessage>
</ValidationRule>
