<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_type_Con_contrato</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(ELM_Order_Type__c, &quot;Con contrato&quot;),
  ISBLANK(N_de_Contrato_servicio_spot__c)
)</errorConditionFormula>
    <errorDisplayField>N_de_Contrato_servicio_spot__c</errorDisplayField>
    <errorMessage>Asegure que el valor del número de contrato es el correcto</errorMessage>
</ValidationRule>
