<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Currency_Qualification_Stage</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 TEXT(StageName) = &quot;Qualification&quot;,
ISBLANK(TEXT( CurrencyIsoCode ))
)</errorConditionFormula>
    <errorDisplayField>CurrencyIsoCode</errorDisplayField>
    <errorMessage>Please fill in the following field Opportunity Currency</errorMessage>
</ValidationRule>
