<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Final_Report_Number_Stage</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 TEXT(StageName) = &quot;Release&quot;,
 ISBLANK(ELM_Final_Report_Number__c)
)</errorConditionFormula>
    <errorDisplayField>ELM_Final_Report_Number__c</errorDisplayField>
    <errorMessage>Please fill in the following field Final Report Number</errorMessage>
</ValidationRule>
