<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Packaging_Stage</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 TEXT(StageName) = &quot;Release&quot;,
 ISBLANK(TEXT(ELM_Packaging__c))
)</errorConditionFormula>
    <errorDisplayField>ELM_Packaging__c</errorDisplayField>
    <errorMessage>Please fill in the following field Packaging</errorMessage>
</ValidationRule>
