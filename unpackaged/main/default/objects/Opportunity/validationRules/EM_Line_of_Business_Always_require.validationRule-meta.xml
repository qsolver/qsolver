<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EM_Line_of_Business_Always_require</fullName>
    <active>false</active>
    <description>El campo Line_of_Business__c, es obligatorio para los perfiles que se detallan en la regla</description>
    <errorConditionFormula>AND(
   ISPICKVAL(ELM_Line_of_Business__c, &quot;&quot;),
   OR( 
       $Profile.Name = &quot;System Administrator&quot;,
       $Profile.Name = &quot;Sales Reps&quot;,
       $Profile.Name = &quot;Manager&quot;,
       $Profile.Name = &quot;USC&quot;
   )
)</errorConditionFormula>
    <errorMessage>completar el campo Linea de Negocios</errorMessage>
</ValidationRule>
