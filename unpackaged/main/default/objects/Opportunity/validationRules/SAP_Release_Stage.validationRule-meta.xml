<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SAP_Release_Stage</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
 TEXT(StageName) = &quot;Release&quot;,
 ISBLANK(TEXT(ELM_SAP_Release__c))
)</errorConditionFormula>
