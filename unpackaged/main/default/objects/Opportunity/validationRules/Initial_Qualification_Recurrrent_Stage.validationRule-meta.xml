<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Initial_Qualification_Recurrrent_Stage</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
RecordType.Name = &quot;Recurring Sale&quot;,
ISNEW(),
TEXT( StageName)&lt;&gt; &quot;Qualification&quot;
)</errorConditionFormula>
    <errorDisplayField>StageName</errorDisplayField>
    <errorMessage>Initial Stage must be Qualification</errorMessage>
</ValidationRule>
