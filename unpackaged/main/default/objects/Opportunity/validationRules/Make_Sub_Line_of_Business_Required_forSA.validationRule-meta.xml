<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Make_Sub_Line_of_Business_Required_forSA</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ELM_Equipo_de_Ventas__c = &#39;SouthAmerica&#39;,
    ISBLANK(TEXT(Sub_Linea_de_Negocio_OPP__c)),
    ISNEW(),
    NOT(
           RecordType.DeveloperName = &#39;Grinding_Media&#39;
    )
)</errorConditionFormula>
    <errorDisplayField>Sub_Linea_de_Negocio_OPP__c</errorDisplayField>
    <errorMessage>Para crear la oportunidad primero necesita llenar el campo Sub Linea de Negocio</errorMessage>
</ValidationRule>
