<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ELM_Presentation_Pending_Days__c</fullName>
    <externalId>false</externalId>
    <formula>IF( NOT(ISBLANK(ELM_Proposal_Date_Real__c)),0,ELM_Activation_Date_Limit__c  -  TODAY()) * 0.3</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Calculation according to the proposal presentation date Plan indicates how many days are left for the proposal presentation</inlineHelpText>
    <label>Proposal Remaining Days</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
