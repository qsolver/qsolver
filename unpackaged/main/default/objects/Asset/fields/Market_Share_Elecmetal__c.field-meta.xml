<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Market_Share_Elecmetal__c</fullName>
    <formula>IF(OR(ISPICKVAL(Account.ELM_Equipo_de_Ventas__c, &quot;SURAMERICA&quot;), ISPICKVAL(Account.ELM_Equipo_de_Ventas__c, &quot;NORTEAMERICA&quot;)) , 

(Consumo_Anual_ME__c / (Consumo_Anual_ME__c +  Consumo_Anual_Otros__c)), 

( Annual_Consumption_Elecmetal_EMEA_APAC__c / ( Annual_Consumption_Elecmetal_EMEA_APAC__c +  Annual_Consumption_Other_EMEA_APAC__c )))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Percentage of Elecmetal&#39;s annual consumption in the Asset</inlineHelpText>
    <label>Market Share Elecmetal %</label>
    <precision>18</precision>
