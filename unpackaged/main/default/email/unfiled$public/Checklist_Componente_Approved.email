<messaging:emailTemplate subject="Check List de Ingreso" recipientType="User" relatedToType="OpportunityLineItem">
    <messaging:htmlEmailBody >
        <html>
            <body>
      <table class="ql-table-blob" style="border-collapse: collapse; table-layout: auto; width: 100%;">
                    <tbody>
                        <tr>
                            <td class="subTitle-border" colspan="7" style="border: 2px solid; padding: 8px; text-align: center; font-weight: bold; font-size: 16px;">
                                CHECK LIST DE INGRESO DE COMPONENTES DESDE CLIENTE
                            </td>
                        </tr>
                        <tr>
                            <td class="subTitle-border-color" colspan="7" style="border: 2px solid; padding: 8px; text-align: center; background-color: #5dade2; font-weight: bold; font-size: 19px; font-style: oblique;">
                                Datos de Ingreso
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                ECO Nº
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 16px;">
                                {!relatedTo.Opportunity.ELM_ECO_Number__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Fecha
                            </td>
                            <td class="response-color border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 19px;">
                                {!relatedTo.Opportunity.CreatedDate}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Nº Oportunidad
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Opportunity_Number__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Correo
                            </td>
                            <td class="border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; font-size: 16px;">
                                {!relatedTo.Opportunity.Owner.Email}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Solicitante
                            </td>
                            <td class="response-color border-left-and-right" colspan="6" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Owner.FirstName} {!relatedTo.Opportunity.Owner.LastName}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Cliente
                            </td>
                            <td class="response-color border-left-and-right" colspan="6" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Account.Name}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Nº de Contrato / servicio spot
                            </td>
                            <td class="border-left-and-right" colspan="6" align="left" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; font-size: 16px;">
                                {!relatedTo.Opportunity.N_de_Contrato_servicio_spot__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Traslado desde faena
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Traslado_desde_faena__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Fecha traslado desde faena
                            </td>
                            <td class="response-color border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 19px;">
                                {!relatedTo.Opportunity.Fecha_traslado_desde_faena__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Traslado hacia faena
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Traslado_hacia_faena__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Fecha requerida de despacho desde CCSS
                            </td>
                            <td class="border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; font-weight: bold; font-size: 19px;">
                                {!relatedTo.Opportunity.Fecha_requerida_de_despacho_desde_CCSS__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Estándar de tralado
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                {!relatedTo.Opportunity.Estandar_de_traslado__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Fecha requerida en faena
                            </td>
                            <td class="border-left-and-right" colspan="6" align="left" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; font-size: 16px;">
                                {!relatedTo.Opportunity.Fecha_requerida_en_faena__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="subTitle-border-color" colspan="7" style="border: 2px solid; padding: 8px; text-align: center; background-color: #5dade2; font-weight: bold; font-size: 19px; font-style: oblique;">
                                Información técnica
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Código SAP
                            </td>
                            <td class="response-background-color border-left-and-right" colspan="6" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; color: red; font-weight: bold; font-size: 32px;">
                                {!relatedTo.Product2.ELM_ExternalId__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Línea
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 19px; font-style: oblique;">
                                {!relatedTo.Opportunity.Linea__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Centro de Servicio
                            </td>
                            <td class="response-color border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 19px;">
                                {!relatedTo.Opportunity.Centro_de_Servicio__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Marca
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 19px; font-style: oblique;">
                                {!relatedTo.Opportunity.Marca__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Part Number
                            </td>
                            <td class="border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; font-weight: bold; font-size: 16px;">
                                {!relatedTo.Opportunity.Part_Number__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Componente
                            </td>
                            <td class="response-background-color border-left-and-right" colspan="6" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; color: red; font-weight: bold; font-size: 24px; font-style: oblique;">
                                {!relatedTo.Product2.Name}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Lote o TAG
                            </td>
                            <td class="response-background-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; color: red; font-weight: bold; font-size: 27px;">
                                {!relatedTo.Opportunity.Lote_o_TAG__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Código
                            </td>
                            <td class="response-background-color border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; color: red; font-weight: bold; font-size: 27px;">
                                {!relatedTo.Product2.ProductCode}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Documentación cliente
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Plano
                            </td>
                            <td class="response-background-color" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; color: red; font-weight: bold; font-size: 21px;">
                                {!relatedTo.Opportunity.Plano__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Informes
                            </td>
                            <td class="" style="border: 0.5px solid black; padding: 8px; text-align: center; font-size: 16px;">
                                {!relatedTo.Opportunity.Informes__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Catálogo
                            </td>
                            <td class="response-background-color border-left-and-right" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; color: red; font-weight: bold; font-size: 21px;">
                                {!relatedTo.Opportunity.Catalogo__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Nº de plano Elecmetal:
                            </td>
                            <td class="" colspan="4" align="left" style="border: 0.5px solid black; padding: 8px; font-size: 16px;">
                                {!relatedTo.Opportunity.N_de_plano_Elecmetal__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                REV
                            </td>
                            <td class="border-left-and-right" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; font-size: 16px;">
                                {!relatedTo.Opportunity.REV__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Descripción del servicio:
                            </td>
                            <td class="border-left-and-right" colspan="6" align="left" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; font-size: 16px;">
                                {!relatedTo.Opportunity.Descripcion_del_servicio__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="subTitle-border-color" colspan="7" style="border: 2px solid; padding: 8px; text-align: center; background-color: #5dade2; font-weight: bold; font-size: 19px; font-style: oblique;">
                                Otros comentarios
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Otros comentarios
                            </td>
                            <td class="response-background-color" colspan="6" align="left" style="border: 0.5px solid black; padding: 8px; background-color: #ffff99; color: red; font-weight: bold; font-size: 15px;">
                                {!relatedTo.Opportunity.Otros_comentarios__c}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </body>
        </html>
    </messaging:htmlEmailBody>
    
    <messaging:attachment filename="checklist.pdf" renderAs="pdf">
        <html>
        <head>
                <style type="text/css">
                    @page {
                        size: letter;
                        margin: 0.3cm;
                    }
                    body {
                        font-family: Arial, sans-serif;
                        font-size: 8pt;
                        margin: 0;
                        padding: 0;
                    }
                    table {
                        width: 100%;
                        border-collapse: collapse;
                        page-break-inside: avoid;
                    }
                    td {
                        padding: 3px;
                        border: 1px solid black;
                        word-break: break-word;
                    }
                    .header {
                        font-weight: bold;
                        text-align: center;
                        background-color: #5dade2;
                        font-size: 10pt;
                    }
                    .field {
                        background-color: #6495ed;
                        color: white;
                        font-weight: bold;
                        text-align: center;
                    }
                    .response {
                        background-color: #ffff99;
                    }
                </style>
            </head>
            <body>
      <table class="ql-table-blob" style="border-collapse: collapse; table-layout: auto; width: 100%;">
                    <tbody>
                        <tr>
                            <td class="subTitle-border" colspan="7" style="border: 2px solid; padding: 8px; text-align: center; font-weight: bold; font-size: 16px;">
