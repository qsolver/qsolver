                            </td>
                        </tr>
                        <tr>
                            <td class="subTitle-border-color" colspan="7" style="border: 2px solid; padding: 8px; text-align: center; background-color: #5dade2; font-weight: bold; font-size: 19px; font-style: oblique;">
                                Datos de Ingreso
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                ECO Nº
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 16px;">
                                {!relatedTo.Opportunity.ELM_ECO_Number__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Fecha
                            </td>
                            <td class="response-color border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 19px;">
                                {!relatedTo.Opportunity.CreatedDate}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Nº Oportunidad
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Opportunity_Number__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Correo
                            </td>
                            <td class="border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; font-size: 16px;">
                                {!relatedTo.Opportunity.Owner.Email}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Solicitante
                            </td>
                            <td class="response-color border-left-and-right" colspan="6" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Owner.FirstName} {!relatedTo.Opportunity.Owner.LastName}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Cliente
                            </td>
                            <td class="response-color border-left-and-right" colspan="6" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Account.Name}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Nº de Contrato / servicio spot
                            </td>
                            <td class="border-left-and-right" colspan="6" align="left" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; font-size: 16px;">
                                {!relatedTo.Opportunity.N_de_Contrato_servicio_spot__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Traslado desde faena
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Traslado_desde_faena__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Fecha traslado desde faena
                            </td>
                            <td class="response-color border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; background-color: #ffff99; font-weight: bold; font-size: 19px;">
                                {!relatedTo.Opportunity.Fecha_traslado_desde_faena__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Traslado hacia faena
                            </td>
                            <td class="response-color" colspan="2" style="border: 0.5px solid black; padding: 8px; text-align: center; background-color: #ffff99; font-size: 16px;">
                                {!relatedTo.Opportunity.Traslado_hacia_faena__c}
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Fecha requerida de despacho desde CCSS
                            </td>
                            <td class="border-left-and-right" colspan="3" style="border-width: 1px 2px 1px 1px; border-style: solid; border-color: black; padding: 8px; text-align: center; font-weight: bold; font-size: 19px;">
                                {!relatedTo.Opportunity.Fecha_requerida_de_despacho_desde_CCSS__c}
                            </td>
                        </tr>
                        <tr>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                Estándar de tralado
                            </td>
                            <td class="field" style="border: 2px solid black; padding: 8px; text-align: center; background-color: #6495ed; font-weight: bold; color: white; font-size: 15px;">
                                {!relatedTo.Opportunity.Estandar_de_traslado__c}
                            </td>
                        </tr>
