<messaging:emailTemplate subject="{!relatedTo.Opportunity_Number__c} SOLICITUD INGRESO {!relatedTo.ELM_Order_Type__c} // {!relatedTo.Account.name} // {!relatedTo.ELM_Line_of_Business__c}" recipientType="User" relatedToType="Opportunity">
