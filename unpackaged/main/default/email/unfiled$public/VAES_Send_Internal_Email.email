<messaging:emailTemplate subject="ATENCION Se ha cerrado el VAES {!relatedTo.ELM_Project_Name__c} Siguiente" recipientType="User" relatedToType="ELM_Vaes__c">
<messaging:htmlEmailBody >
        <html font-size = "8.5pt">
    
            <body style = "font-family: Calibri; size: 8pt;">
                <h1 style="padding-top: 6pt;padding-left: 46pt;text-indent: 0pt; color: #2D74B5; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 18pt;">

                </h1>
                <p style="color: #808080; font-family:Corbel, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt; margin:0pt; text-indent: 0pt;text-align: left;"><br/></p>
                <table style="border-collapse:collapse;margin-left:6.025pt; vertical-align: top; overflow: visible;" cellspacing="0">
                    <tr style="height:24pt">
                        <td style="width:128pt" bgcolor="#2D74B5">
                            <p  style="padding-top: 6pt;padding-left: 6pt;text-indent: 0pt;text-align: left; color: #FFF; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                Nombre Proyecto
                            </p>
                        </td>
                        <td style="width:312pt;padding-right: 25px" bgcolor="#2D74B5">
                            <p  style="padding-top: 6pt;padding-left: 6pt;text-indent: 0pt;text-align: left; color: #FFF; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                {!relatedTo.ELM_Project_Name__c}
                            </p>
                        </td>
                    </tr>
                    <tr style="height:23pt">
                        <td style="width:128pt;border-left-style:solid;border-left-width:1pt;border-left-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #1F477B; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                Cliente:
                            </p>
                        </td>
                        <td style="width:312pt;padding-right: 25px;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB;border-right-style:solid;border-right-width:1pt;border-right-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #A6A6A6; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                {!relatedTo.ELM_Account__r.Name}
                            </p>
                        </td>
                    </tr>
                    <tr style="height:23pt">
                        <td style="width:128pt;border-left-style:solid;border-left-width:1pt;border-left-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #1F477B; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                Equipo:
                            </p>
                        </td>
                        <td style="width:312pt;padding-right: 25px;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB;border-right-style:solid;border-right-width:1pt;border-right-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #A6A6A6; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                {!relatedTo.ELM_Asset__r.Name}
                            </p>
                        </td>
                    </tr>
                    
                    <tr style="height:23pt">
                        <td style="width:128pt;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-left-style:solid;border-left-width:1pt;border-left-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #1F477B; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                Gerente de la cuenta:</p>
                            </td>
                            <td style="width:312pt;padding-right: 25px;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB;border-right-style:solid;border-right-width:1pt;border-right-color:#4F81BB">
                                <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #A6A6A6; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                    {!relatedTo.NX_Vendedor_Asignado__c}
                                </p>
                            </td>
                        </tr>
                        <tr style="height:23pt">
                            <td style="width:128pt;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-left-style:solid;border-left-width:1pt;border-left-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB">
                                <p  style="padding-top: 4pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #1F477B; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                    Fecha:
                                </p>
                            </td>
                            <td style="width:312pt;padding-right: 25px;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB;border-right-style:solid;border-right-width:1pt;border-right-color:#4F81BB">
                                <p  style="padding-top: 4pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #A6A6A6; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                    <apex:outputText value="{0,date,dd/MM/yyyy}">
                                        <apex:param value="{!relatedTo.ELM_Fecha_cierre__c}" />
                                    </apex:outputText>
                                </p>
                            </td>
                        </tr>
                        
                        <tr style="height:26pt"><td style="width:128pt;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-left-style:solid;border-left-width:1pt;border-left-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB">
                            <p  style="padding-top: 6pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #1F477B; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                Resumen Ejecutivo:
                            </p>
                        </td>
                        <td style="width:312pt;padding-right: 25px;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB;border-right-style:solid;border-right-width:1pt;border-right-color:#4F81BB">
                            <p  style="padding-left: 5pt;text-indent: 0pt;line-height: 13pt;text-align: left ;">
                                <div  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #A6A6A6; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                <apex:outputText value="{!relatedTo.ELM_Resumen__c}" escape="false"/>
                            </div>
                            </p>
                        </td>
                    </tr>
                    <tr style="height:23pt">
                        <td style="width:128pt;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-left-style:solid;border-left-width:1pt;border-left-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #1F477B; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                Número Proyecto:
                            </p>
                        </td>
                        <td style="width:312pt;padding-right: 25px;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB;border-right-style:solid;border-right-width:1pt;border-right-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #A6A6A6; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                {!relatedTo.Name}
                            </p>
                        </td>
                    </tr>
                    <tr style="height:23pt">
                        <td style="width:128pt;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-left-style:solid;border-left-width:1pt;border-left-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #1F477B; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                Resultado más importante:
                            </p>
                        </td>
                        <td style="width:312pt;padding-right: 25px;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB;border-right-style:solid;border-right-width:1pt;border-right-color:#4F81BB">
                            <div  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #A6A6A6; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                <apex:outputText value="{!relatedTo.ELM_Resultado_mas_importante__c}" escape="false"/>
                            </div>
                        </td>
                    </tr>
                     <tr style="height:23pt">
                        <td style="width:128pt;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-left-style:solid;border-left-width:1pt;border-left-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB">
                            <p  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #1F477B; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 11pt;">
                                Link al VAES:
                            </p>
                        </td>
                        <td style="width:312pt;padding-right: 25px;border-top-style:solid;border-top-width:1pt;border-top-color:#4F81BB;border-bottom-style:solid;border-bottom-width:1pt;border-bottom-color:#4F81BB;border-right-style:solid;border-right-width:1pt;border-right-color:#4F81BB">
                            <div  style="padding-top: 5pt;padding-left: 5pt;text-indent: 0pt;text-align: left; color: #A6A6A6; font-family:Arial, sans-serif; font-style: normal; font-weight: normal; text-decoration: none; font-size: 11pt;">
                                <a href="{!LEFT($Api.Partner_Server_URL_550, FIND('/services', $Api.Partner_Server_URL_550)) + relatedTo.Id}" style="color: #2D74B5; text-decoration: underline; font-weight: bold;">
                                    Ver en Salesforce
                                </a>
                            </div>
                        </td>
                    </tr>
                </table>
               
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>