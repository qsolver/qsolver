                            <p style="color: black; font-family:Calibri, sans-serif; font-style: normal;  text-decoration: none; font-size: 10.5pt; margin:0pt;">
                                {!relatedTo.ELM_Propuestaaprobadacon_c_digo_de_pieza__c}
                            </p>
                        </td>
                    
                    </tr>
                    <tr style="height:15pt">
                        <th style="width:220pt;border-top-style:solid;border-top-width:2pt;border-left-style:solid;border-left-width:2pt;border-bottom-style:solid;border-bottom-width:2pt;border-right-style:solid;border-right-width:2pt" bgcolor="#366092">
                            <p style="color: black; font-family:Calibri, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 15.5pt; margin:0pt;color: #FFF; font-family:Arial, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 10.5pt; padding-top: 1pt;padding-left: 3pt;text-indent: 0pt;line-height: 12pt;text-align: left;">
