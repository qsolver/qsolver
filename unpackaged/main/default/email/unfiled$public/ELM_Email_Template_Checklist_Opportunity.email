<messaging:emailTemplate subject="Checklist" recipientType="User" relatedToType="Opportunity">
    <messaging:htmlEmailBody >
        <html font-size = "8.5pt">
    
            <body>
                <p style="color: black; font-family:Calibri, sans-serif; font-style: normal; font-weight: bold; text-decoration: none; font-size: 15.5pt; margin:0pt;padding-top: 1pt;padding-left: 9pt;text-indent: 0pt;text-align: left;">
                    CHECK LIST REQUISITOS BASICOS PARA INGRESAR PEDIDO SIN OC
                </p>
