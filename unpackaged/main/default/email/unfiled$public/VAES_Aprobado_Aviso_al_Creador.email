<table style="border-collapse: collapse; width: 100%;">
    <tr>
        <th style="border: 1px solid black; padding: 8px;">Campo</th>
        <th style="border: 1px solid black; padding: 8px;">Valor</th>
    </tr>
    <tr>
        <td style="border: 1px solid black; padding: 8px;">Nombre del Proyecto</td>
        <td style="border: 1px solid black; padding: 8px;">{!ELM_Vaes__c.ELM_Project_Name__c} ({!ELM_Vaes__c.Name})</td>
    </tr>
    <tr>
        <td style="border: 1px solid black; padding: 8px;">Cuenta</td>
        <td style="border: 1px solid black; padding: 8px;">{!ELM_Vaes__c.ELM_Account__c}</td>
    </tr>
    <tr>
        <td style="border: 1px solid black; padding: 8px;">Creado por</td>
        <td style="border: 1px solid black; padding: 8px;">{!ELM_Vaes__c.CreatedBy}</td>
    </tr>
    <tr>
        <td style="border: 1px solid black; padding: 8px;">Fecha esperada de cierre</td>
        <td style="border: 1px solid black; padding: 8px;">{!ELM_Vaes__c.Fecha_de_cierre_proyectada__c}</td>
    </tr>
    <tr>
        <td style="border: 1px solid black; padding: 8px;">Link al VAES</td>
        <td style="border: 1px solid black; padding: 8px;"><a href="{!ELM_Vaes__c.Link}">Click aquí</a></td>
    </tr>
</table>