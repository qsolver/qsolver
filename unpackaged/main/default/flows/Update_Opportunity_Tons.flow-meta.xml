    <description>Updates the value in the Tons Field to the total added Opportunity Product weight in Tons</description>
    <environments>Default</environments>
    <formulas>
        <name>CalcMetricTons</name>
        <dataType>Number</dataType>
        <expression>IF({!ProductCount} &gt;= 1, IF({!$Record.ELM_Equipo_de_Ventas__c} = &#39;SURAMERICA&#39;, {!$Record.Opportunity_Weight__c}/1000, IF(CONTAINS(&#39;Conduct_A_Trial,Expand_At_Existing_Site,Repeat_Sale,Secure_Trial&#39;, {!$Record.RecordType.DeveloperName}),{!SumMetricTons},{!$Record.Opportunity_Weight__c}/2000)),0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedMetricTons</name>
        <dataType>Number</dataType>
        <expression>CASE({!Loop_Opportunity_Product.ELM_Weight_Unit__c}, &#39;LB&#39;, {!Loop_Opportunity_Product.Total_Item_Weight__c} / 2204.6, &#39;KG&#39;, {!Loop_Opportunity_Product.Total_Item_Weight__c} / 1000, {!Loop_Opportunity_Product.Total_Item_Weight__c})</expression>
        <scale>3</scale>
    </formulas>
    <formulas>
        <name>CalculatedShortTons</name>
        <dataType>Number</dataType>
        <expression>CASE({!Loop_Opportunity_Product.ELM_Weight_Unit__c}, &#39;LB&#39;, {!Loop_Opportunity_Product.Total_Item_Weight__c} / 2000, &#39;KG&#39;, {!Loop_Opportunity_Product.Total_Item_Weight__c} / 907.2, {!Loop_Opportunity_Product.Total_Item_Weight__c} / 0.9071847)</expression>
        <scale>3</scale>
    </formulas>
    <formulas>
        <name>MetricTons</name>
        <dataType>Number</dataType>
        <expression>CASE({!Loop_Opportunity_Product.ELM_Weight_Unit__c}, &#39;LB&#39;, {!Loop_Opportunity_Product.Total_Item_Weight__c} / 2205, &#39;KG&#39;, {!Loop_Opportunity_Product.Total_Item_Weight__c} / 1000, {!Loop_Opportunity_Product.Total_Item_Weight__c})</expression>
        <scale>2</scale>
    </formulas>
