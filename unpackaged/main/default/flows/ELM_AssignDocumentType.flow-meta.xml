<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!-- Dynamic Choice Set: Lee los valores del picklist desde File Link -->
    <dynamicChoiceSets>
        <name>pcs_DocTypeQuote</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object>File_Link__c</object>
        <picklistField>Doc_Type_Quotes__c</picklistField>
        <picklistObject>File_Link__c</picklistObject>
    </dynamicChoiceSets>

    <!-- Pantalla: Muestra el desplegable con las opciones del Picklist -->
    <screens>
        <name>Assign_Document_Type_Quote</name>
        <label>Assign Document Type</label>
        <locationX>3746</locationX>
        <locationY>874</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_File_Link_Quote</targetReference>
        </connector>
        <fields>
            <name>Doc_Type_Quotes_Input</name>
            <choiceReferences>pcs_DocTypeQuote</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Doc Type Quotes</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <!-- Update Records: Guarda la opción seleccionada en el registro File Link -->
    <recordUpdates>
        <name>Update_File_Link_Quote</name>
        <label>Update File Link Quote</label>
        <locationX>3746</locationX>
        <locationY>1000</locationY>
        <connector>
            <targetReference>Get_File_Link_Associated_To_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_DocumentId.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Doc_Type_Quotes__c</field>
            <value>
                <elementReference>Doc_Type_Quotes_Input</elementReference>
            </value>
        </inputAssignments>
        <object>File_Link__c</object>
    </recordUpdates>

    <!-- Action Call: Alerta Toast de éxito para Quotes -->
    <actionCalls>
        <name>ELM_QuoteSuccessAlert</name>
        <label>Quote Success Alert</label>
        <locationX>3746</locationX>
        <locationY>1274</locationY>
        <actionName>c:ShowToastFlow</actionName>
        <actionType>component</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>message</name>
            <value>
                <stringValue>And a File Link record was created! {url}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>The document was uploaded successfully!</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>urlLabel</name>
            <value>
                <stringValue>Link to the record.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>urlLink</name>
            <value>
                <elementReference>ELM_LinkFormulaQuote</elementReference>
            </value>
        </inputParameters>
        <nameSegment>c:ShowToastFlow</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>

</Flow>
