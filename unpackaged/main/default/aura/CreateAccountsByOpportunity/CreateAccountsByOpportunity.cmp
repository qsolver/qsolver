<aura:component implements="lightning:isUrlAddressable,force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,lightning:actionOverride"  access="global">
    <!-- Pass the ID of the Opportunity to the LWC-->
    <aura:attribute name="recordId" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <lightning:card>
        <c:createAccountsByOpportunityLWC recordId="{!v.recordId}"/>
    </lightning:card>
</aura:component>