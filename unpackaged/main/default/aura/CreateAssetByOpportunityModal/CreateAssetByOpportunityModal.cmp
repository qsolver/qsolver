<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,lightning:hasPageReference,force:hasRecordId,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable" access="global" >
    
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="opportunityId" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <lightning:card>
        <c:createAssetsByOpportunityLWC opportunityId="{!v.opportunityId}"/>  
    </lightning:card>
    
</aura:component>