    <pathAssistantSteps>
        <info>&lt;p&gt;Now that you&amp;#39;ve won the sale, &lt;b&gt;make sure you have a Signed P.O&lt;/b&gt;, &lt;b&gt;the Order has been entered into SAP&lt;/b&gt;, a &lt;b&gt;Maintenance Plan to Support the sale&lt;/b&gt; and create an opportunity for the &lt;b&gt;Customer&amp;#39;s re-order date&lt;/b&gt;. &lt;/p&gt;</info>
        <picklistValueName>Closed Won</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>Description</fieldNames>
        <fieldNames>Customer_Equipment__c</fieldNames>
        <info>&lt;p&gt;Specify the &lt;b&gt;Amount of the Opportunity&lt;/b&gt;, &lt;b&gt;Description&lt;/b&gt;, &lt;b&gt;Customer Equipment&lt;/b&gt;.&lt;/p&gt;</info>
        <picklistValueName>Qualification</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>ME_FIT_Program__c</fieldNames>
        <fieldNames>Current_Supplier__c</fieldNames>
        <fieldNames>Technical_Requirements__c</fieldNames>
        <fieldNames>Commercial_Support_Requirements__c</fieldNames>
        <fieldNames>Product_Test_Plan__c</fieldNames>
        <info>&lt;p&gt;Specify if the Opportunity is a &lt;b&gt;ME FIT Program&lt;/b&gt;, the &lt;b&gt;Customer&amp;#39;s Current Supplier&lt;/b&gt;, the &lt;b&gt;Technical Requirements&lt;/b&gt;, the&lt;b&gt; Commercial Support Requirements&lt;/b&gt;, and the &lt;b&gt;Product Test Plan&lt;/b&gt;.&lt;/p&gt;</info>
